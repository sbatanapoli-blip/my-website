<?xml version="1.0" encoding="utf-8"?>
<layer-list
    xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape
            android:shape="rectangle">
            <solid
                android:color="#e6000000" />
            <corners
                android:radius="28.0dip" />
        </shape>
    </item>
    <item
        android:bottom="40.0dip">
        <shape
            android:shape="rectangle">
            <gradient
                android:startColor="#28ffffff"
                android:endColor="#00ffffff"
                android:angle="270.0"
                android:type="linear"
                android:centerColor="#0cffffff" />
            <corners
                android:topLeftRadius="28.0dip"
                android:topRightRadius="28.0dip"
                android:bottomLeftRadius="10.0dip"
                android:bottomRightRadius="10.0dip" />
        </shape>
    </item>
    <item
        android:left="12.0dip"
        android:right="12.0dip"
        android:bottom="60.0dip">
        <shape
            android:shape="rectangle">
            <gradient
                android:startColor="#40ffffff"
                android:endColor="#00ffffff"
                android:angle="270.0"
                android:type="linear" />
            <corners
                android:radius="2.0dip" />
        </shape>
    </item>
    <item
        android:top="48.0dip">
        <shape
            android:shape="rectangle">
            <gradient
                android:startColor="#00000000"
                android:endColor="#20000000"
                android:angle="270.0"
                android:type="linear" />
            <corners
                android:topLeftRadius="4.0dip"
                android:topRightRadius="4.0dip"
                android:bottomLeftRadius="28.0dip"
                android:bottomRightRadius="28.0dip" />
        </shape>
    </item>
    <item>
        <shape
            android:shape="rectangle">
            <stroke
                android:width="1.0dip"
                android:color="#22ffffff" />
            <corners
                android:radius="28.0dip" />
        </shape>
    </item>
</layer-list>