<?xml version="1.0" encoding="utf-8"?>
<layer-list
    xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape
            android:shape="rectangle">
            <solid
                android:color="#33000000" />
            <corners
                android:radius="28.0dip" />
        </shape>
    </item>
    <item
        android:bottom="32.0dip">
        <shape
            android:shape="rectangle">
            <gradient
                android:startColor="#18ffffff"
                android:endColor="#00ffffff"
                android:angle="270.0"
                android:type="linear" />
            <corners
                android:topLeftRadius="28.0dip"
                android:topRightRadius="28.0dip"
                android:bottomLeftRadius="6.0dip"
                android:bottomRightRadius="6.0dip" />
        </shape>
    </item>
    <item>
        <shape
            android:shape="rectangle">
            <stroke
                android:width="1.0dip"
                android:color="#55ffffff" />
            <corners
                android:radius="28.0dip" />
        </shape>
    </item>
</layer-list>