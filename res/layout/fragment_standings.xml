<?xml version="1.0" encoding="utf-8"?>
<androidx.swiperefreshlayout.widget.SwipeRefreshLayout
    android:id="@id/swipeRefresh"
    android:layout_width="fill_parent"
    android:layout_height="fill_parent"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:background="?android:colorBackground"
        android:layout_width="fill_parent"
        android:layout_height="fill_parent">
        <TextView
            android:textSize="18.0sp"
            android:textStyle="bold"
            android:textColor="@color/bottom_nav_text_selected"
            android:gravity="center"
            android:id="@id/leagueTitle"
            android:padding="10.0dip"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:fontFamily="@font/kufi"
            app:layout_constraintTop_toTopOf="parent" />
        <LinearLayout
            android:orientation="horizontal"
            android:id="@id/tableHeader"
            android:background="?colorSurface"
            android:padding="8.0dip"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            app:layout_constraintTop_toBottomOf="@id/leagueTitle">
            <TextView
                android:textSize="11.0sp"
                android:textStyle="bold"
                android:textColor="?colorOnSurface"
                android:gravity="center"
                android:layout_width="40.0dip"
                android:layout_height="wrap_content"
                android:text="نقاط" />
            <TextView
                android:textSize="11.0sp"
                android:textStyle="bold"
                android:textColor="?colorOnSurface"
                android:gravity="center"
                android:layout_width="30.0dip"
                android:layout_height="wrap_content"
                android:text="خسارة" />
            <TextView
                android:textSize="11.0sp"
                android:textStyle="bold"
                android:textColor="?colorOnSurface"
                android:gravity="center"
                android:layout_width="30.0dip"
                android:layout_height="wrap_content"
                android:text="تعادل" />
            <TextView
                android:textSize="11.0sp"
                android:textStyle="bold"
                android:textColor="?colorOnSurface"
                android:gravity="center"
                android:layout_width="30.0dip"
                android:layout_height="wrap_content"
                android:text="فوز" />
            <TextView
                android:textSize="11.0sp"
                android:textStyle="bold"
                android:textColor="?colorOnSurface"
                android:gravity="center"
                android:layout_width="30.0dip"
                android:layout_height="wrap_content"
                android:text="لعب" />
            <TextView
                android:textStyle="bold"
                android:textColor="?colorOnSurface"
                android:gravity="center"
                android:layout_width="0.0dip"
                android:layout_height="wrap_content"
                android:text="الفريق"
                android:layout_weight="1.0"
                android:paddingStart="8.0dip"
                android:paddingEnd="8.0dip" />
            <TextView
                android:textStyle="bold"
                android:textColor="?colorOnSurface"
                android:gravity="center"
                android:layout_width="40.0dip"
                android:layout_height="wrap_content"
                android:text="\#" />
        </LinearLayout>
        <androidx.recyclerview.widget.RecyclerView
            android:id="@id/standingsRecyclerView"
            android:layout_width="fill_parent"
            android:layout_height="0.0dip"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tableHeader" />
        <ProgressBar
            android:id="@id/progressBar"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:indeterminateTint="@color/bottom_nav_icon_unselected"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />
        <LinearLayout
            android:gravity="center"
            android:orientation="vertical"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">
            <TextView
                android:textSize="16.0sp"
                android:textColor="?colorOnSurface"
                android:id="@id/emptyView"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/no_data" />
            <com.google.android.material.button.MaterialButton
                android:textSize="16.0sp"
                android:textColor="@color/black"
                android:id="@id/retryButton"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16.0dip"
                android:text="@string/retry"
                android:backgroundTint="@color/bottom_nav_icon_unselected"
                style="@style/Widget.Material3.Button" />
        </LinearLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.swiperefreshlayout.widget.SwipeRefreshLayout>