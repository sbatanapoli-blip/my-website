<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView
    android:layout_width="fill_parent"
    android:layout_height="wrap_content"
    app:cardBackgroundColor="#ff1e1e1e"
    app:cardCornerRadius="16.0dip"
    app:cardElevation="8.0dip"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <LinearLayout
        android:orientation="vertical"
        android:padding="6.0dip"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content">
        <TextView
            android:textSize="12.0sp"
            android:textStyle="bold"
            android:textColor="@android:color/white"
            android:layout_gravity="center"
            android:id="@id/tv_live_badge"
            android:paddingLeft="10.0dip"
            android:paddingTop="3.0dip"
            android:paddingRight="10.0dip"
            android:paddingBottom="3.0dip"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="6.0dip"
            android:text=" تفاصيل المباراة "
            android:fontFamily="@font/kufi"
            android:paddingHorizontal="10.0dip"
            android:paddingVertical="3.0dip" />
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8.0dip">
            <ImageView
                android:id="@id/btn_close_dialog"
                android:background="?selectableItemBackgroundBorderless"
                android:padding="4.0dip"
                android:layout_width="28.0dip"
                android:layout_height="28.0dip"
                android:src="@drawable/ic_close"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:tint="#ffb0b0b0" />
        </androidx.constraintlayout.widget.ConstraintLayout>
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingTop="5.0dip"
            android:paddingBottom="5.0dip"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:baselineAligned="false"
            android:paddingVertical="5.0dip">
            <LinearLayout
                android:gravity="center"
                android:orientation="vertical"
                android:paddingLeft="3.0dip"
                android:paddingRight="3.0dip"
                android:layout_width="0.0dip"
                android:layout_height="wrap_content"
                android:layout_weight="1.0"
                android:paddingHorizontal="3.0dip">
                <ImageView
                    android:id="@id/img_home_logo"
                    android:layout_width="48.0dip"
                    android:layout_height="48.0dip"
                    android:contentDescription="ic_sports" />
                <TextView
                    android:textSize="12.0sp"
                    android:textStyle="bold"
                    android:textColor="@android:color/white"
                    android:ellipsize="end"
                    android:gravity="center"
                    android:id="@id/tv_home_team"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4.0dip"
                    android:maxLines="2"
                    android:fontFamily="@font/kufi" />
            </LinearLayout>
            <LinearLayout
                android:gravity="center"
                android:orientation="vertical"
                android:paddingLeft="10.0dip"
                android:paddingRight="10.0dip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingHorizontal="10.0dip">
                <TextView
                    android:textSize="24.0sp"
                    android:textStyle="bold"
                    android:textColor="@color/bottom_nav_text_selected"
                    android:id="@id/tv_score"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:letterSpacing="0.1" />
                <TextView
                    android:textSize="12.0sp"
                    android:textStyle="bold"
                    android:textColor="#ffff5252"
                    android:id="@id/tv_match_minute"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="1.0dip" />
                <LinearLayout
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingLeft="4.0dip"
                    android:paddingRight="4.0dip"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2.0dip"
                    android:paddingHorizontal="4.0dip">
                    <View
                        android:id="@id/live_dot_indicator"
                        android:background="@drawable/live_dot"
                        android:visibility="gone"
                        android:layout_width="8.0dip"
                        android:layout_height="8.0dip"
                        android:layout_marginEnd="6.0dip" />
                    <TextView
                        android:textSize="10.0sp"
                        android:textStyle="bold"
                        android:textColor="#ff4caf50"
                        android:id="@id/tv_match_status"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/kufi" />
                </LinearLayout>
            </LinearLayout>
            <LinearLayout
                android:gravity="center"
                android:orientation="vertical"
                android:paddingLeft="3.0dip"
                android:paddingRight="3.0dip"
                android:layout_width="0.0dip"
                android:layout_height="wrap_content"
                android:layout_weight="1.0"
                android:paddingHorizontal="3.0dip">
                <ImageView
                    android:id="@id/img_away_logo"
                    android:layout_width="48.0dip"
                    android:layout_height="48.0dip"
                    android:contentDescription="ic_sports" />
                <TextView
                    android:textSize="12.0sp"
                    android:textStyle="bold"
                    android:textColor="@android:color/white"
                    android:ellipsize="end"
                    android:gravity="center"
                    android:id="@id/tv_away_team"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4.0dip"
                    android:maxLines="2"
                    android:fontFamily="@font/kufi" />
            </LinearLayout>
        </LinearLayout>
        <TextView
            android:textSize="10.0sp"
            android:textColor="#ff909090"
            android:layout_gravity="center"
            android:id="@id/tv_stadium"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6.0dip"
            android:layout_marginBottom="3.0dip"
            android:fontFamily="@font/kufi" />
        <LinearLayout
            android:orientation="horizontal"
            android:background="@drawable/bg_tabs_container"
            android:padding="2.0dip"
            android:layout_width="fill_parent"
            android:layout_height="36.0dip"
            android:layout_marginTop="8.0dip">
            <TextView
                android:textSize="12.0sp"
                android:textStyle="bold"
                android:textColor="#ffffffff"
                android:gravity="center"
                android:id="@id/tab_events"
                android:background="@drawable/bg_tab_selected"
                android:layout_width="0.0dip"
                android:layout_height="fill_parent"
                android:text="الأحداث"
                android:layout_weight="1.0"
                android:fontFamily="@font/kufi" />
            <TextView
                android:textSize="12.0sp"
                android:textColor="#ffb0b0b0"
                android:gravity="center"
                android:id="@id/tab_lineups"
                android:layout_width="0.0dip"
                android:layout_height="fill_parent"
                android:text="التشكيلة"
                android:layout_weight="1.0"
                android:fontFamily="@font/kufi" />
            <TextView
                android:textSize="12.0sp"
                android:textColor="#ffb0b0b0"
                android:gravity="center"
                android:id="@id/tab_channels"
                android:layout_width="0.0dip"
                android:layout_height="fill_parent"
                android:text="القنوات"
                android:layout_weight="1.0"
                android:fontFamily="@font/kufi" />
        </LinearLayout>
        <View
            android:background="#ff2a2a2a"
            android:layout_width="fill_parent"
            android:layout_height="1.0dip"
            android:layout_marginTop="10.0dip"
            android:layout_marginBottom="6.0dip" />
        <androidx.core.widget.NestedScrollView
            android:scrollbars="vertical"
            android:layout_width="fill_parent"
            android:layout_height="240.0dip"
            android:fillViewport="true"
            android:fadeScrollbars="true">
            <FrameLayout
                android:layout_width="fill_parent"
                android:layout_height="wrap_content">
                <LinearLayout
                    android:orientation="vertical"
                    android:id="@id/layout_events_container"
                    android:paddingTop="3.0dip"
                    android:paddingBottom="3.0dip"
                    android:visibility="visible"
                    android:layout_width="fill_parent"
                    android:layout_height="wrap_content"
                    android:paddingVertical="3.0dip" />
                <LinearLayout
                    android:orientation="vertical"
                    android:id="@id/layout_lineups_container"
                    android:padding="12.0dip"
                    android:visibility="gone"
                    android:layout_width="fill_parent"
                    android:layout_height="wrap_content">
                    <LinearLayout
                        android:gravity="center"
                        android:orientation="horizontal"
                        android:layout_width="fill_parent"
                        android:layout_height="wrap_content"
                        android:weightSum="2.0">
                        <LinearLayout
                            android:gravity="center"
                            android:orientation="vertical"
                            android:padding="6.0dip"
                            android:layout_width="0.0dip"
                            android:layout_height="wrap_content"
                            android:layout_weight="1.0">
                            <ImageView
                                android:id="@id/img_home_lineup_logo"
                                android:layout_width="60.0dip"
                                android:layout_height="60.0dip"
                                android:src="@drawable/ic_team_placeholder"
                                android:contentDescription="home_team_logo" />
                            <TextView
                                android:textSize="12.0sp"
                                android:textStyle="bold"
                                android:textColor="@android:color/white"
                                android:ellipsize="end"
                                android:gravity="center"
                                android:id="@id/tv_home_lineup_name"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="6.0dip"
                                android:text="الفريق المضيف"
                                android:maxLines="2"
                                android:fontFamily="@font/kufi" />
                            <androidx.cardview.widget.CardView
                                android:id="@id/btn_show_home_lineup"
                                android:focusable="true"
                                android:clickable="true"
                                android:layout_width="fill_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="10.0dip"
                                android:foreground="?selectableItemBackground"
                                app:cardBackgroundColor="@color/bottom_nav_text_selected"
                                app:cardCornerRadius="8.0dip"
                                app:cardElevation="2.0dip">
                                <TextView
                                    android:textSize="11.0sp"
                                    android:textStyle="bold"
                                    android:textColor="#ff474747"
                                    android:gravity="center"
                                    android:padding="10.0dip"
                                    android:layout_width="fill_parent"
                                    android:layout_height="wrap_content"
                                    android:text="عرض التشكيلة"
                                    android:fontFamily="@font/kufi" />
                            </androidx.cardview.widget.CardView>
                        </LinearLayout>
                        <LinearLayout
                            android:gravity="center"
                            android:orientation="vertical"
                            android:padding="6.0dip"
                            android:layout_width="0.0dip"
                            android:layout_height="wrap_content"
                            android:layout_weight="1.0">
                            <ImageView
                                android:id="@id/img_away_lineup_logo"
                                android:layout_width="60.0dip"
                                android:layout_height="60.0dip"
                                android:src="@drawable/ic_team_placeholder"
                                android:contentDescription="away_team_logo" />
                            <TextView
                                android:textSize="12.0sp"
                                android:textStyle="bold"
                                android:textColor="@android:color/white"
                                android:ellipsize="end"
                                android:gravity="center"
                                android:id="@id/tv_away_lineup_name"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="6.0dip"
                                android:text="الفريق الضيف"
                                android:maxLines="2"
                                android:fontFamily="@font/kufi" />
                            <androidx.cardview.widget.CardView
                                android:id="@id/btn_show_away_lineup"
                                android:focusable="true"
                                android:clickable="true"
                                android:layout_width="fill_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="10.0dip"
                                android:foreground="?selectableItemBackground"
                                app:cardBackgroundColor="#ffffffff"
                                app:cardCornerRadius="8.0dip"
                                app:cardElevation="2.0dip">
                                <TextView
                                    android:textSize="11.0sp"
                                    android:textStyle="bold"
                                    android:textColor="@android:color/black"
                                    android:gravity="center"
                                    android:padding="10.0dip"
                                    android:layout_width="fill_parent"
                                    android:layout_height="wrap_content"
                                    android:text="عرض التشكيلة"
                                    android:fontFamily="@font/kufi" />
                            </androidx.cardview.widget.CardView>
                        </LinearLayout>
                    </LinearLayout>
                    <TextView
                        android:textSize="12.0sp"
                        android:textColor="@android:color/darker_gray"
                        android:layout_gravity="center"
                        android:id="@id/tv_no_lineup_message"
                        android:visibility="gone"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="20.0dip"
                        android:text="التشكيلة غير متوفرة"
                        android:fontFamily="@font/kufi" />
                </LinearLayout>
                <LinearLayout
                    android:orientation="vertical"
                    android:id="@id/layout_channels_container"
                    android:paddingTop="3.0dip"
                    android:paddingBottom="3.0dip"
                    android:visibility="gone"
                    android:layout_width="fill_parent"
                    android:layout_height="wrap_content"
                    android:paddingVertical="3.0dip" />
            </FrameLayout>
        </androidx.core.widget.NestedScrollView>
    </LinearLayout>
</androidx.cardview.widget.CardView>