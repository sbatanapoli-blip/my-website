<?xml version="1.0" encoding="utf-8"?>
<FrameLayout
    android:id="@id/channels_overlay_root"
    android:focusable="true"
    android:visibility="gone"
    android:clickable="true"
    android:layout_width="fill_parent"
    android:layout_height="fill_parent"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <View
        android:id="@id/overlay_background"
        android:background="@drawable/bg_overlay_gradient"
        android:layout_width="fill_parent"
        android:layout_height="fill_parent" />
    <LinearLayout
        android:gravity="center_vertical"
        android:layout_gravity="start"
        android:orientation="horizontal"
        android:id="@id/channels_overlay_content"
        android:layout_width="wrap_content"
        android:layout_height="fill_parent"
        android:paddingStart="16.0dip"
        android:paddingEnd="8.0dip">
        <androidx.recyclerview.widget.RecyclerView
            android:id="@id/packages_overlay_recycler"
            android:paddingTop="10.0dip"
            android:paddingBottom="10.0dip"
            android:scrollbars="vertical"
            android:clipToPadding="false"
            android:layout_width="150.0dip"
            android:layout_height="fill_parent"
            android:layout_marginEnd="10.0dip" />
        <androidx.recyclerview.widget.RecyclerView
            android:id="@id/channels_overlay_recycler"
            android:paddingTop="10.0dip"
            android:paddingBottom="10.0dip"
            android:scrollbars="vertical"
            android:clipToPadding="false"
            android:layout_width="200.0dip"
            android:layout_height="fill_parent" />
    </LinearLayout>
</FrameLayout>