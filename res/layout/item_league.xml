<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    android:id="@id/leagueCard"
    android:focusable="true"
    android:clickable="true"
    android:layout_width="fill_parent"
    android:layout_height="wrap_content"
    android:layout_margin="0.0dip"
    android:foreground="?selectableItemBackground"
    app:cardBackgroundColor="?colorSurface"
    app:cardCornerRadius="12.0dip"
    app:cardElevation="4.0dip"
    app:strokeColor="@color/bottom_nav_icon_unselected"
    app:strokeWidth="2.0dip"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <LinearLayout
        android:gravity="center"
        android:orientation="vertical"
        android:padding="12.0dip"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content">
        <com.google.android.material.card.MaterialCardView
            android:layout_width="80.0dip"
            android:layout_height="80.0dip"
            app:cardBackgroundColor="@android:color/transparent"
            app:cardCornerRadius="40.0dip"
            app:cardElevation="0.0dip"
            app:strokeWidth="0.0dip">
            <FrameLayout
                android:background="@drawable/white_circle_background"
                android:layout_width="fill_parent"
                android:layout_height="fill_parent">
                <ImageView
                    android:layout_gravity="center"
                    android:id="@id/leagueLogo"
                    android:layout_width="fill_parent"
                    android:layout_height="fill_parent"
                    android:scaleType="centerInside"
                    android:adjustViewBounds="true" />
            </FrameLayout>
        </com.google.android.material.card.MaterialCardView>
        <TextView
            android:textSize="12.0sp"
            android:textStyle="bold"
            android:textColor="@color/yellow_button"
            android:ellipsize="end"
            android:gravity="center"
            android:id="@id/leagueName"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8.0dip"
            android:maxLines="2"
            android:lineSpacingExtra="2.0dip"
            android:fontFamily="@font/kufi" />
        <TextView
            android:textSize="10.0sp"
            android:textColor="?colorOnSurface"
            android:gravity="center"
            android:id="@id/leagueSeason"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4.0dip"
            android:maxLines="1"
            android:alpha="0.7" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>