<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView
    android:layout_width="fill_parent"
    android:layout_height="wrap_content"
    android:layout_margin="16.0dip"
    app:cardCornerRadius="16.0dip"
    app:cardElevation="8.0dip"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <LinearLayout
        android:gravity="center"
        android:orientation="vertical"
        android:background="@drawable/dialog_background"
        android:padding="24.0dip"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content">
        <ImageView
            android:id="@id/telegramIcon"
            android:layout_width="70.0dip"
            android:layout_height="70.0dip"
            android:src="@drawable/join_telegram"
            android:contentDescription="Telegram Icon" />
        <TextView
            android:textSize="20.0sp"
            android:textStyle="bold"
            android:textColor="@color/bottom_nav_text_selected"
            android:id="@id/tvTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16.0dip"
            android:text="انضم إلى قناتنا"
            android:fontFamily="@font/kufi" />
        <TextView
            android:textSize="14.0sp"
            android:textColor="@android:color/white"
            android:gravity="center"
            android:id="@id/tvMessage"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8.0dip"
            android:text="تابع آخر التحديثات والأخبار على قناتنا في تيليجرام"
            android:fontFamily="@font/kufi" />
        <LinearLayout
            android:gravity="center"
            android:orientation="horizontal"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20.0dip">
            <com.google.android.material.button.MaterialButton
                android:textColor="@android:color/white"
                android:id="@id/btnJoin"
                android:layout_width="0.0dip"
                android:layout_height="wrap_content"
                android:text="انضم الآن"
                android:layout_weight="1.0"
                android:fontFamily="@font/kufi"
                android:layout_marginEnd="8.0dip"
                app:backgroundTint="#ff0088cc"
                app:cornerRadius="8.0dip" />
            <com.google.android.material.button.MaterialButton
                android:textColor="#ffffffff"
                android:id="@id/btnLater"
                android:layout_width="0.0dip"
                android:layout_height="wrap_content"
                android:text="لاحقاً"
                android:layout_weight="1.0"
                android:fontFamily="@font/kufi"
                android:layout_marginStart="8.0dip"
                app:backgroundTint="#ff818181"
                app:cornerRadius="8.0dip" />
        </LinearLayout>
    </LinearLayout>
</androidx.cardview.widget.CardView>