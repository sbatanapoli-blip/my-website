<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    android:background="#ff000000"
    android:padding="32.0dip"
    android:layout_width="fill_parent"
    android:layout_height="fill_parent"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <ImageView
        android:id="@id/logo"
        android:layout_width="150.0dip"
        android:layout_height="150.0dip"
        android:src="@drawable/banner"
        android:contentDescription="@null"
        app:layout_constraintBottom_toTopOf="@id/title"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_chainStyle="packed" />
    <TextView
        android:textSize="22.0sp"
        android:textStyle="bold"
        android:textColor="@color/white"
        android:id="@id/title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="24.0dip"
        android:text="Activation Required"
        app:layout_constraintBottom_toTopOf="@id/subtitle"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/logo" />
    <TextView
        android:textSize="14.0sp"
        android:textColor="#ffcccccc"
        android:id="@id/subtitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8.0dip"
        android:text="Please enter your code to continue"
        app:layout_constraintBottom_toTopOf="@id/codeContainer"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/title" />
    <com.google.android.material.textfield.TextInputLayout
        android:id="@id/codeContainer"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="32.0dip"
        android:hint="Activation Code"
        app:boxBackgroundColor="#1affffff"
        app:boxBackgroundMode="outline"
        app:boxCornerRadiusBottomEnd="14.0dip"
        app:boxCornerRadiusBottomStart="14.0dip"
        app:boxCornerRadiusTopEnd="14.0dip"
        app:boxCornerRadiusTopStart="14.0dip"
        app:boxStrokeColor="#ff6a6a6a"
        app:boxStrokeWidth="1.0dip"
        app:boxStrokeWidthFocused="2.0dip"
        app:hintTextColor="#80ffffff"
        app:layout_constraintBottom_toTopOf="@id/btnActivate"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/subtitle">
        <com.google.android.material.textfield.TextInputEditText
            android:textSize="16.0sp"
            android:textColor="@color/white"
            android:textColorHint="#80ffffff"
            android:id="@id/etCode"
            android:background="@null"
            android:padding="16.0dip"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:singleLine="true"
            android:inputType="number" />
    </com.google.android.material.textfield.TextInputLayout>
    <com.google.android.material.button.MaterialButton
        android:textSize="16.0sp"
        android:textStyle="bold"
        android:textColor="@color/white"
        android:id="@id/btnActivate"
        android:layout_width="fill_parent"
        android:layout_height="56.0dip"
        android:layout_marginTop="24.0dip"
        android:text="Activate Now"
        app:backgroundTint="#ff6a6a6a"
        app:cornerRadius="14.0dip"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/codeContainer" />
    <ProgressBar
        android:id="@id/progressBar"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="24.0dip"
        android:indeterminateTint="@color/white"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/btnActivate" />
</androidx.constraintlayout.widget.ConstraintLayout>