<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    android:background="#ff121212"
    android:paddingLeft="64.0dip"
    android:paddingRight="64.0dip"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:layout_width="fill_parent"
    android:layout_height="fill_parent"
    android:layoutDirection="ltr"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <ImageView
        android:id="@id/logo_app"
        android:layout_width="260.0dip"
        android:layout_height="100.0dip"
        android:layout_marginTop="48.0dip"
        android:src="@drawable/logo_tv"
        android:scaleType="fitCenter"
        android:contentDescription="@string/app_name"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />
    <com.google.android.material.card.MaterialCardView
        android:id="@id/liveTvCard"
        android:focusable="true"
        android:clickable="true"
        android:layout_width="0.0dip"
        android:layout_height="260.0dip"
        android:foreground="?selectableItemBackground"
        android:layout_marginEnd="24.0dip"
        app:cardBackgroundColor="#ff262626"
        app:cardCornerRadius="24.0dip"
        app:cardElevation="8.0dip"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@id/liveEventsCard"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/logo_app"
        app:layout_constraintVertical_bias="0.15">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:padding="32.0dip"
            android:layout_width="fill_parent"
            android:layout_height="fill_parent">
            <ImageView
                android:id="@id/liveTvIcon"
                android:layout_width="100.0dip"
                android:layout_height="100.0dip"
                android:src="@drawable/ic_live_tv"
                android:scaleType="fitCenter"
                app:layout_constraintBottom_toTopOf="@id/liveTvTitle"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintVertical_chainStyle="packed"
                app:tint="@color/bottom_nav_text_selected" />
            <TextView
                android:textSize="26.0sp"
                android:textStyle="bold"
                android:textColor="@android:color/white"
                android:id="@id/liveTvTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20.0dip"
                android:text="Live TV"
                app:layout_constraintBottom_toTopOf="@id/liveTvChannels"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/liveTvIcon" />
            <TextView
                android:textSize="18.0sp"
                android:textColor="@android:color/white"
                android:id="@id/liveTvChannels"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8.0dip"
                android:text="+5000 Channels"
                android:alpha="0.7"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/liveTvTitle" />
        </androidx.constraintlayout.widget.ConstraintLayout>
    </com.google.android.material.card.MaterialCardView>
    <com.google.android.material.card.MaterialCardView
        android:id="@id/liveEventsCard"
        android:focusable="true"
        android:clickable="true"
        android:layout_width="0.0dip"
        android:layout_height="260.0dip"
        android:foreground="?selectableItemBackground"
        android:layout_marginStart="24.0dip"
        app:cardBackgroundColor="#ff262626"
        app:cardCornerRadius="24.0dip"
        app:cardElevation="8.0dip"
        app:layout_constraintBottom_toBottomOf="@id/liveTvCard"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@id/liveTvCard"
        app:layout_constraintTop_toTopOf="@id/liveTvCard">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:padding="32.0dip"
            android:layout_width="fill_parent"
            android:layout_height="fill_parent">
            <ImageView
                android:id="@id/liveEventsIcon"
                android:layout_width="100.0dip"
                android:layout_height="100.0dip"
                android:src="@drawable/ic_sports"
                android:scaleType="fitCenter"
                app:layout_constraintBottom_toTopOf="@id/liveEventsTitle"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintVertical_chainStyle="packed"
                app:tint="@color/bottom_nav_text_selected" />
            <TextView
                android:textSize="26.0sp"
                android:textStyle="bold"
                android:textColor="@android:color/white"
                android:id="@id/liveEventsTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20.0dip"
                android:text="Live Events"
                app:layout_constraintBottom_toTopOf="@id/liveEventsMatches"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/liveEventsIcon" />
            <TextView
                android:textSize="18.0sp"
                android:textColor="@android:color/white"
                android:id="@id/liveEventsMatches"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8.0dip"
                android:text="Live Matches"
                android:alpha="0.7"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/liveEventsTitle" />
        </androidx.constraintlayout.widget.ConstraintLayout>
    </com.google.android.material.card.MaterialCardView>
</androidx.constraintlayout.widget.ConstraintLayout>