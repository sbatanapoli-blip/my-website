<?xml version="1.0" encoding="utf-8"?>
<FrameLayout
    android:background="#b3000000"
    android:layout_width="fill_parent"
    android:layout_height="fill_parent"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <androidx.cardview.widget.CardView
        android:layout_gravity="center"
        android:layout_width="320.0dip"
        android:layout_height="wrap_content"
        android:backgroundTint="#ff232323"
        app:cardCornerRadius="22.0dip"
        app:cardElevation="12.0dip">
        <LinearLayout
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:padding="20.0dip"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content">
            <com.airbnb.lottie.LottieAnimationView
                android:id="@id/updateAnimation"
                android:layout_width="100.0dip"
                android:layout_height="100.0dip"
                app:lottie_autoPlay="true"
                app:lottie_loop="true"
                app:lottie_rawRes="@raw/update_animation" />
            <TextView
                android:textSize="20.0sp"
                android:textStyle="bold"
                android:textColor="@color/bottom_nav_text_selected"
                android:gravity="center"
                android:id="@id/titleText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8.0dip"
                android:text="🚀 تحديث جديد"
                android:fontFamily="@font/kufi" />
            <TextView
                android:textSize="14.0sp"
                android:textColor="@android:color/white"
                android:gravity="center"
                android:id="@id/messageText"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8.0dip"
                android:layout_marginBottom="16.0dip"
                android:text="يتوفر تحديث هام وإلزامي لضمان استقرار التطبيق."
                android:lineSpacingExtra="4.0dip"
                android:fontFamily="@font/kufi" />
            <ProgressBar
                android:id="@id/progressBar"
                android:visibility="gone"
                android:layout_width="fill_parent"
                android:layout_height="6.0dip"
                android:progressTint="@color/green_live"
                android:progressBackgroundTint="#ff333333"
                style="?android:progressBarStyleHorizontal" />
            <TextView
                android:textStyle="bold"
                android:textColor="@color/bottom_nav_text_selected"
                android:id="@id/tvProgress"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6.0dip"
                android:text="0%"
                android:fontFamily="@font/kufi" />
            <LinearLayout
                android:gravity="center"
                android:orientation="horizontal"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18.0dip">
                <com.google.android.material.button.MaterialButton
                    android:textSize="14.0sp"
                    android:textColor="@android:color/white"
                    android:id="@id/btnCloseApp"
                    android:layout_width="0.0dip"
                    android:layout_height="45.0dip"
                    android:text="إغلاق"
                    android:layout_weight="1.0"
                    android:fontFamily="@font/kufi"
                    android:layout_marginEnd="6.0dip"
                    android:backgroundTint="#ff333333"
                    app:cornerRadius="14.0dip" />
                <com.google.android.material.button.MaterialButton
                    android:textSize="14.0sp"
                    android:textColor="@color/black"
                    android:id="@id/btnUpdateNow"
                    android:layout_width="0.0dip"
                    android:layout_height="45.0dip"
                    android:text="تحديث"
                    android:layout_weight="1.0"
                    android:fontFamily="@font/kufi"
                    android:layout_marginStart="6.0dip"
                    android:backgroundTint="@color/bottom_nav_text_selected"
                    app:cornerRadius="14.0dip" />
            </LinearLayout>
            <TextView
                android:textSize="11.0sp"
                android:textColor="#ffffa726"
                android:gravity="center"
                android:id="@id/warningText"
                android:visibility="gone"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10.0dip"
                android:text="⚠️ قد يستغرق التحديث بضع دقائق"
                android:fontFamily="@font/kufi" />
        </LinearLayout>
    </androidx.cardview.widget.CardView>
</FrameLayout>