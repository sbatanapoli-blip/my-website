<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView
    android:layout_width="fill_parent"
    android:layout_height="wrap_content"
    android:layout_margin="8.0dip"
    app:cardBackgroundColor="#ff1e1e1e"
    app:cardCornerRadius="12.0dip"
    app:cardElevation="2.0dip"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <LinearLayout
        android:orientation="horizontal"
        android:padding="12.0dip"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content">
        <ImageView
            android:layout_gravity="center_vertical"
            android:id="@id/app_icon"
            android:layout_width="48.0dip"
            android:layout_height="48.0dip"
            android:src="@android:drawable/ic_dialog_alert" />
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="0.0dip"
            android:layout_height="wrap_content"
            android:layout_weight="1.0"
            android:layout_marginStart="12.0dip"
            android:layout_marginEnd="12.0dip">
            <TextView
                android:textSize="16.0sp"
                android:textStyle="bold"
                android:textColor="#ffffffff"
                android:id="@id/app_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="App Name" />
            <TextView
                android:textSize="12.0sp"
                android:textColor="#ff9e9e9e"
                android:id="@id/package_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2.0dip"
                android:text="com.example.app" />
            <TextView
                android:textSize="13.0sp"
                android:textStyle="bold"
                android:textColor="#ffff5252"
                android:id="@id/threat_level"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4.0dip"
                android:text="⛔ خطورة عالية" />
            <TextView
                android:textSize="12.0sp"
                android:textColor="#ffbdbdbd"
                android:id="@id/reason"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4.0dip"
                android:text="تطبيق تجسس معروف" />
        </LinearLayout>
        <com.google.android.material.button.MaterialButton
            android:textSize="12.0sp"
            android:textColor="#ffffffff"
            android:layout_gravity="center_vertical"
            android:id="@id/uninstall_button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="إزالة"
            app:backgroundTint="#ffff5252"
            app:cornerRadius="8.0dip" />
    </LinearLayout>
</androidx.cardview.widget.CardView>