<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    android:background="#ff1e1e1e"
    android:padding="24.0dip"
    android:layout_width="fill_parent"
    android:layout_height="fill_parent"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <com.airbnb.lottie.LottieAnimationView
        android:id="@id/no_internet_animation"
        android:layout_width="300.0dip"
        android:layout_height="300.0dip"
        app:layout_constraintBottom_toTopOf="@id/no_internet_title"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_chainStyle="packed"
        app:lottie_autoPlay="true"
        app:lottie_loop="true"
        app:lottie_rawRes="@raw/no_internet_connection" />
    <TextView
        android:textSize="20.0sp"
        android:textStyle="bold"
        android:textColor="#ffffffff"
        android:id="@id/no_internet_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="32.0dip"
        android:text="لا يوجد اتصال بالإنترنت !"
        android:fontFamily="@font/kufi"
        app:layout_constraintBottom_toTopOf="@id/no_internet_message"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/no_internet_animation" />
    <TextView
        android:textSize="14.0sp"
        android:textColor="#ffb0b0b0"
        android:gravity="center"
        android:id="@id/no_internet_message"
        android:layout_width="0.0dip"
        android:layout_height="wrap_content"
        android:layout_marginTop="12.0dip"
        android:text="تحقق من اتصالك بالإنترنت وحاول مرة أخرى"
        android:fontFamily="@font/kufi"
        app:layout_constraintBottom_toTopOf="@id/retry_button"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/no_internet_title"
        app:layout_constraintWidth_max="300.0dip" />
    <com.google.android.material.button.MaterialButton
        android:textSize="12.0sp"
        android:textStyle="bold"
        android:textColor="#ffffffff"
        android:id="@id/retry_button"
        android:paddingLeft="48.0dip"
        android:paddingTop="10.0dip"
        android:paddingRight="48.0dip"
        android:paddingBottom="10.0dip"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="32.0dip"
        android:text="إعادة المحاولة"
        android:fontFamily="@font/kufi"
        app:backgroundTint="@color/bottom_nav_icon_unselected"
        app:cornerRadius="24.0dip"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/no_internet_message" />
</androidx.constraintlayout.widget.ConstraintLayout>