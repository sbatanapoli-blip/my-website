<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    android:layout_width="fill_parent"
    android:layout_height="wrap_content"
    app:cardBackgroundColor="#ff1e1e1e"
    app:cardCornerRadius="16.0dip"
    app:cardElevation="8.0dip"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <LinearLayout
        android:orientation="vertical"
        android:padding="24.0dip"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content">
        <TextView
            android:textSize="20.0sp"
            android:textStyle="bold"
            android:textColor="@color/white"
            android:id="@id/txtTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="تحديث جديد متوفر"
            android:fontFamily="@font/kufi" />
        <TextView
            android:textSize="14.0sp"
            android:textColor="#ffb0b0b0"
            android:id="@id/txtVersion"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8.0dip"
            android:text="الإصدار: 1.0.1"
            android:fontFamily="@font/kufi" />
        <ProgressBar
            android:id="@id/progressBar"
            android:visibility="gone"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24.0dip"
            android:max="100"
            android:progressDrawable="@drawable/bottom_nav_item_background"
            style="?android:progressBarStyleHorizontal" />
        <TextView
            android:textColor="@color/bottom_nav_icon_unselected"
            android:layout_gravity="center"
            android:id="@id/txtProgress"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4.0dip"
            android:text="0%" />
        <Button
            android:textStyle="bold"
            android:textColor="@color/light_surface"
            android:id="@id/btnUpdate"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24.0dip"
            android:text="تحديث الآن"
            android:fontFamily="@font/kufi"
            android:backgroundTint="@color/bottom_nav_text_selected" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>