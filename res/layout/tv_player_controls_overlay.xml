<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    android:background="#b3000000"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:layout_width="fill_parent"
    android:layout_height="fill_parent"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <LinearLayout
        android:orientation="horizontal"
        android:id="@id/tvControlButtonsRow"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="40.0dip"
        android:layout_marginEnd="40.0dip"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <TextView
            android:textSize="14.0sp"
            android:textStyle="bold"
            android:textColor="#ffffffff"
            android:gravity="center"
            android:id="@id/btnTvServers"
            android:background="@drawable/bg_tv_control_btn"
            android:paddingLeft="24.0dip"
            android:paddingRight="24.0dip"
            android:focusable="true"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="44.0dip"
            android:text="Servers"
            android:layout_marginEnd="12.0dip"
            android:paddingHorizontal="24.0dip" />
        <TextView
            android:textSize="14.0sp"
            android:textStyle="bold"
            android:textColor="#ffffffff"
            android:gravity="center"
            android:id="@id/btnTvQuality"
            android:background="@drawable/bg_tv_control_btn"
            android:paddingLeft="24.0dip"
            android:paddingRight="24.0dip"
            android:focusable="true"
            android:layout_width="wrap_content"
            android:layout_height="44.0dip"
            android:text="Quality"
            android:layout_marginEnd="12.0dip"
            android:paddingHorizontal="24.0dip" />
        <TextView
            android:textSize="14.0sp"
            android:textStyle="bold"
            android:textColor="#ffffffff"
            android:gravity="center"
            android:id="@id/btnTvAudio"
            android:background="@drawable/bg_tv_control_btn"
            android:paddingLeft="24.0dip"
            android:paddingRight="24.0dip"
            android:focusable="true"
            android:layout_width="wrap_content"
            android:layout_height="44.0dip"
            android:text="Audio"
            android:paddingHorizontal="24.0dip" />
    </LinearLayout>
    <FrameLayout
        android:id="@id/tvChipsWrapper"
        android:visibility="gone"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12.0dip"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tvControlButtonsRow">
        <HorizontalScrollView
            android:id="@id/tvChipsScrollView"
            android:background="@android:color/transparent"
            android:scrollbars="none"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">
            <LinearLayout
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:id="@id/tvChipsContainer"
                android:background="@drawable/bg_dropdown_menu"
                android:padding="12.0dip"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />
        </HorizontalScrollView>
    </FrameLayout>
</androidx.constraintlayout.widget.ConstraintLayout>