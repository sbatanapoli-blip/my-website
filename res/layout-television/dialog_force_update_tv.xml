<?xml version="1.0" encoding="utf-8"?>
<FrameLayout
    android:background="#e6000000"
    android:focusable="false"
    android:clickable="true"
    android:layout_width="fill_parent"
    android:layout_height="fill_parent"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <androidx.cardview.widget.CardView
        android:layout_gravity="center"
        android:layout_width="550.0dip"
        android:layout_height="wrap_content"
        android:layout_margin="24.0dip"
        app:cardBackgroundColor="#ff222222"
        app:cardCornerRadius="28.0dip"
        app:cardElevation="20.0dip">
        <LinearLayout
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingTop="48.0dip"
            android:paddingBottom="40.0dip"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:paddingStart="40.0dip"
            android:paddingEnd="40.0dip">
            <com.airbnb.lottie.LottieAnimationView
                android:id="@id/updateAnimation"
                android:layout_width="160.0dip"
                android:layout_height="160.0dip"
                android:layout_marginBottom="20.0dip"
                app:lottie_autoPlay="true"
                app:lottie_loop="true"
                app:lottie_rawRes="@raw/update_animation" />
            <TextView
                android:textSize="32.0sp"
                android:textStyle="bold"
                android:textColor="@android:color/white"
                android:gravity="center"
                android:id="@id/titleText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🚀 تحديث جديد متوفر" />
            <TextView
                android:textSize="18.0sp"
                android:textColor="#ffd1d1d1"
                android:gravity="center"
                android:id="@id/messageText"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16.0dip"
                android:layout_marginBottom="32.0dip"
                android:text="يتوفر إصدار جديد يحتوي على تحسينات هامة للأداء والاستقرار.\nيرجى التحديث الآن للمتابعة."
                android:lineSpacingMultiplier="1.4" />
            <LinearLayout
                android:orientation="vertical"
                android:id="@id/progressContainer"
                android:visibility="gone"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="32.0dip">
                <ProgressBar
                    android:id="@id/progressBar"
                    android:layout_width="fill_parent"
                    android:layout_height="12.0dip"
                    android:progressTint="#ff4caf50"
                    android:progressBackgroundTint="#ff444444"
                    style="?android:progressBarStyleHorizontal" />
                <TextView
                    android:textSize="16.0sp"
                    android:textColor="#ff4caf50"
                    android:layout_gravity="end"
                    android:id="@id/tvProgress"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10.0dip"
                    android:text="0%" />
            </LinearLayout>
            <LinearLayout
                android:gravity="center"
                android:orientation="horizontal"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content">
                <com.google.android.material.button.MaterialButton
                    android:textSize="18.0sp"
                    android:textColor="#ffffffff"
                    android:id="@id/btnCloseApp"
                    android:focusable="true"
                    android:focusableInTouchMode="true"
                    android:layout_width="0.0dip"
                    android:layout_height="70.0dip"
                    android:text="إغلاق"
                    android:layout_weight="1.0"
                    android:layout_marginEnd="12.0dip"
                    app:backgroundTint="#ff373636"
                    app:cornerRadius="20.0dip"
                    app:strokeColor="#44ffffff"
                    app:strokeWidth="2.0dip" />
                <com.google.android.material.button.MaterialButton
                    android:textSize="18.0sp"
                    android:textStyle="bold"
                    android:textColor="#ff000000"
                    android:id="@id/btnUpdateNow"
                    android:focusable="true"
                    android:focusableInTouchMode="true"
                    android:layout_width="0.0dip"
                    android:layout_height="70.0dip"
                    android:text="تحديث الآن"
                    android:layout_weight="1.0"
                    android:layout_marginStart="12.0dip"
                    app:backgroundTint="#ffffffff"
                    app:cornerRadius="20.0dip"
                    app:elevation="8.0dip" />
            </LinearLayout>
            <TextView
                android:textSize="14.0sp"
                android:textColor="#ffffb74d"
                android:gravity="center"
                android:id="@id/warningText"
                android:visibility="gone"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24.0dip"
                android:text="⚠️ يرجى عدم إغلاق التطبيق أو فصل الطاقة أثناء التحديث"
                android:alpha="0.9" />
        </LinearLayout>
    </androidx.cardview.widget.CardView>
</FrameLayout>