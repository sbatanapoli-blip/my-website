<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    android:background="?android:colorBackground"
    android:layout_width="fill_parent"
    android:layout_height="fill_parent"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <LinearLayout
        android:orientation="vertical"
        android:padding="16.0dip"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content">
        <TextView
            android:textSize="24.0sp"
            android:textStyle="bold"
            android:textColor="@color/bottom_nav_text_selected"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24.0dip"
            android:text="@string/settings" />
        <com.google.android.material.card.MaterialCardView
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16.0dip"
            app:cardBackgroundColor="?colorSurface"
            app:cardCornerRadius="12.0dip"
            app:cardElevation="4.0dip">
            <LinearLayout
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="16.0dip"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content">
                <ImageView
                    android:layout_width="40.0dip"
                    android:layout_height="40.0dip"
                    android:src="@drawable/ic_theme"
                    android:contentDescription="@string/switch_theme"
                    app:tint="@color/bottom_nav_icon_unselected" />
                <LinearLayout
                    android:orientation="vertical"
                    android:layout_width="0.0dip"
                    android:layout_height="wrap_content"
                    android:layout_weight="1.0"
                    android:layout_marginStart="16.0dip">
                    <TextView
                        android:textSize="16.0sp"
                        android:textStyle="bold"
                        android:textColor="?colorOnSurface"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/dark_mode" />
                    <TextView
                        android:textSize="12.0sp"
                        android:textColor="?colorOnSurface"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4.0dip"
                        android:text="@string/dark_mode_desc"
                        android:alpha="0.7" />
                </LinearLayout>
                <com.google.android.material.switchmaterial.SwitchMaterial
                    android:id="@id/darkModeSwitch"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:thumbTint="@color/switch_thumb_color"
                    app:trackTint="@color/switch_track_color" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
        <com.google.android.material.card.MaterialCardView
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16.0dip"
            app:cardBackgroundColor="?colorSurface"
            app:cardCornerRadius="12.0dip"
            app:cardElevation="4.0dip">
            <LinearLayout
                android:orientation="vertical"
                android:padding="16.0dip"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content">
                <LinearLayout
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:layout_width="fill_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16.0dip">
                    <ImageView
                        android:layout_width="40.0dip"
                        android:layout_height="40.0dip"
                        android:src="@drawable/ic_language"
                        android:contentDescription="ic_language"
                        app:tint="@color/bottom_nav_icon_unselected" />
                    <TextView
                        android:textSize="16.0sp"
                        android:textStyle="bold"
                        android:textColor="?colorOnSurface"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/language"
                        android:layout_marginStart="16.0dip" />
                </LinearLayout>
                <RadioGroup
                    android:orientation="vertical"
                    android:layout_width="fill_parent"
                    android:layout_height="wrap_content">
                    <com.google.android.material.radiobutton.MaterialRadioButton
                        android:textSize="14.0sp"
                        android:textColor="?colorOnSurface"
                        android:id="@id/arabicRadio"
                        android:padding="12.0dip"
                        android:layout_width="fill_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/arabic"
                        app:buttonTint="@color/bottom_nav_icon_unselected" />
                    <com.google.android.material.radiobutton.MaterialRadioButton
                        android:textSize="14.0sp"
                        android:textColor="?colorOnSurface"
                        android:id="@id/englishRadio"
                        android:padding="12.0dip"
                        android:layout_width="fill_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/english"
                        app:buttonTint="@color/bottom_nav_icon_unselected" />
                </RadioGroup>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
        <com.google.android.material.card.MaterialCardView
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16.0dip"
            app:cardBackgroundColor="?colorSurface"
            app:cardCornerRadius="12.0dip"
            app:cardElevation="4.0dip">
            <LinearLayout
                android:orientation="vertical"
                android:padding="16.0dip"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content">
                <LinearLayout
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:layout_width="fill_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16.0dip">
                    <ImageView
                        android:layout_width="40.0dip"
                        android:layout_height="40.0dip"
                        android:src="@drawable/ic_notification"
                        android:contentDescription="Notifications"
                        app:tint="@color/bottom_nav_icon_unselected" />
                    <TextView
                        android:textSize="16.0sp"
                        android:textStyle="bold"
                        android:textColor="?colorOnSurface"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/enable_notifications_title"
                        android:layout_marginStart="16.0dip" />
                </LinearLayout>
                <LinearLayout
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingTop="8.0dip"
                    android:paddingBottom="8.0dip"
                    android:layout_width="fill_parent"
                    android:layout_height="wrap_content"
                    android:paddingVertical="8.0dip">
                    <LinearLayout
                        android:orientation="vertical"
                        android:layout_width="0.0dip"
                        android:layout_height="wrap_content"
                        android:layout_weight="1.0">
                        <TextView
                            android:textSize="14.0sp"
                            android:textColor="?colorOnSurface"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/enable_notifications" />
                        <TextView
                            android:textSize="11.0sp"
                            android:textColor="?colorOnSurface"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2.0dip"
                            android:text="@string/notification_before_match"
                            android:alpha="0.6" />
                    </LinearLayout>
                    <com.google.android.material.switchmaterial.SwitchMaterial
                        android:id="@id/switchNotifications"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        app:thumbTint="@color/switch_thumb_color"
                        app:trackTint="@color/switch_track_color" />
                </LinearLayout>
                <View
                    android:background="?colorOnSurface"
                    android:layout_width="fill_parent"
                    android:layout_height="1.0dip"
                    android:layout_marginTop="8.0dip"
                    android:layout_marginBottom="8.0dip"
                    android:alpha="0.1"
                    android:layout_marginVertical="8.0dip" />
                <LinearLayout
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingTop="8.0dip"
                    android:paddingBottom="8.0dip"
                    android:layout_width="fill_parent"
                    android:layout_height="wrap_content"
                    android:paddingVertical="8.0dip">
                    <TextView
                        android:textSize="14.0sp"
                        android:textColor="?colorOnSurface"
                        android:layout_width="0.0dip"
                        android:layout_height="wrap_content"
                        android:text="@string/notification_time_title"
                        android:layout_weight="1.0" />
                    <Spinner
                        android:id="@id/spinnerNotificationTime"
                        android:layout_width="120.0dip"
                        android:layout_height="wrap_content"
                        android:spinnerMode="dropdown" />
                </LinearLayout>
                <View
                    android:background="?colorOnSurface"
                    android:layout_width="fill_parent"
                    android:layout_height="1.0dip"
                    android:layout_marginTop="8.0dip"
                    android:layout_marginBottom="8.0dip"
                    android:alpha="0.1"
                    android:layout_marginVertical="8.0dip" />
                <LinearLayout
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingTop="8.0dip"
                    android:paddingBottom="8.0dip"
                    android:layout_width="fill_parent"
                    android:layout_height="wrap_content"
                    android:paddingVertical="8.0dip">
                    <TextView
                        android:textSize="14.0sp"
                        android:textColor="?colorOnSurface"
                        android:layout_width="0.0dip"
                        android:layout_height="wrap_content"
                        android:text="@string/vibrate"
                        android:layout_weight="1.0" />
                    <com.google.android.material.switchmaterial.SwitchMaterial
                        android:id="@id/switchVibrate"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        app:thumbTint="@color/switch_thumb_color"
                        app:trackTint="@color/switch_track_color" />
                </LinearLayout>
                <View
                    android:background="?colorOnSurface"
                    android:layout_width="fill_parent"
                    android:layout_height="1.0dip"
                    android:layout_marginTop="8.0dip"
                    android:layout_marginBottom="8.0dip"
                    android:alpha="0.1"
                    android:layout_marginVertical="8.0dip" />
                <LinearLayout
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingTop="8.0dip"
                    android:paddingBottom="8.0dip"
                    android:layout_width="fill_parent"
                    android:layout_height="wrap_content"
                    android:paddingVertical="8.0dip">
                    <TextView
                        android:textSize="14.0sp"
                        android:textColor="?colorOnSurface"
                        android:layout_width="0.0dip"
                        android:layout_height="wrap_content"
                        android:text="@string/sound"
                        android:layout_weight="1.0" />
                    <com.google.android.material.switchmaterial.SwitchMaterial
                        android:id="@id/switchSound"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        app:thumbTint="@color/switch_thumb_color"
                        app:trackTint="@color/switch_track_color" />
                </LinearLayout>
                <com.google.android.material.button.MaterialButton
                    android:textSize="14.0sp"
                    android:textColor="@color/bottom_nav_text_selected"
                    android:id="@id/buttonTestNotification"
                    android:layout_width="fill_parent"
                    android:layout_height="48.0dip"
                    android:layout_marginTop="12.0dip"
                    android:text="@string/test_notification"
                    android:backgroundTint="@color/bottom_nav_icon_unselected"
                    app:cornerRadius="8.0dip"
                    app:icon="@drawable/ic_notification"
                    app:iconGravity="textStart"
                    app:iconSize="20.0dip"
                    app:iconTint="@android:color/white" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
        <com.google.android.material.card.MaterialCardView
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16.0dip"
            app:cardBackgroundColor="?colorSurface"
            app:cardCornerRadius="12.0dip"
            app:cardElevation="4.0dip">
            <LinearLayout
                android:gravity="center"
                android:orientation="vertical"
                android:padding="16.0dip"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content">
                <TextView
                    android:textSize="18.0sp"
                    android:textStyle="bold"
                    android:textColor="@color/bottom_nav_icon_unselected"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/app_name" />
                <TextView
                    android:textSize="12.0sp"
                    android:textColor="?colorOnSurface"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4.0dip"
                    android:text="1.4.0"
                    android:alpha="0.7" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
    </LinearLayout>
</ScrollView>