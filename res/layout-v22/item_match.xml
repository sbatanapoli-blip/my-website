<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    android:layout_width="fill_parent"
    android:layout_height="wrap_content"
    android:layout_marginLeft="12.0dip"
    android:layout_marginTop="6.0dip"
    android:layout_marginRight="12.0dip"
    android:layout_marginBottom="6.0dip"
    android:layout_marginHorizontal="12.0dip"
    android:layout_marginVertical="6.0dip"
    app:cardBackgroundColor="?colorSurface"
    app:cardCornerRadius="16.0dip"
    app:cardElevation="4.0dip"
    app:strokeWidth="0.0dip"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:padding="0.0dip"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content">
        <TextView
            android:textSize="11.0sp"
            android:textStyle="bold"
            android:textColor="#ff4caf50"
            android:id="@id/matchStatus"
            android:paddingLeft="10.0dip"
            android:paddingTop="4.0dip"
            android:paddingRight="10.0dip"
            android:paddingBottom="4.0dip"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/kufi"
            android:paddingHorizontal="10.0dip"
            android:paddingVertical="4.0dip"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@id/teamsSection"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8.0dip"
            app:layout_constraintTop_toBottomOf="@id/matchStatus">
            <com.google.android.material.card.MaterialCardView
                android:id="@id/homeTeamLogoCard"
                android:layout_width="70.0dip"
                android:layout_height="70.0dip"
                app:cardCornerRadius="12.0dip"
                app:cardElevation="2.0dip"
                app:layout_constraintEnd_toStartOf="@id/guidelineLeft"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:strokeColor="#1af9a825"
                app:strokeWidth="1.0dip">
                <ImageView
                    android:id="@id/homeTeamLogo"
                    android:padding="8.0dip"
                    android:layout_width="fill_parent"
                    android:layout_height="fill_parent"
                    android:scaleType="fitCenter"
                    android:contentDescription="@string/leagues" />
            </com.google.android.material.card.MaterialCardView>
            <TextView
                android:textSize="10.0sp"
                android:textStyle="bold"
                android:textColor="?colorOnSurface"
                android:gravity="center"
                android:id="@id/homeTeamName"
                android:layout_width="0.0dip"
                android:layout_height="wrap_content"
                android:layout_marginTop="8.0dip"
                android:fontFamily="@font/kufi"
                app:layout_constraintEnd_toStartOf="@id/guidelineLeft"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/homeTeamLogoCard" />
            <com.google.android.material.card.MaterialCardView
                android:id="@id/awayTeamLogoCard"
                android:layout_width="70.0dip"
                android:layout_height="70.0dip"
                app:cardCornerRadius="12.0dip"
                app:cardElevation="2.0dip"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@id/guidelineRight"
                app:layout_constraintTop_toTopOf="parent"
                app:strokeColor="#1af9a825"
                app:strokeWidth="1.0dip">
                <ImageView
                    android:id="@id/awayTeamLogo"
                    android:padding="8.0dip"
                    android:layout_width="fill_parent"
                    android:layout_height="fill_parent"
                    android:scaleType="fitCenter"
                    android:contentDescription="@string/leagues" />
            </com.google.android.material.card.MaterialCardView>
            <TextView
                android:textSize="10.0sp"
                android:textStyle="bold"
                android:textColor="?colorOnSurface"
                android:gravity="center"
                android:id="@id/awayTeamName"
                android:layout_width="0.0dip"
                android:layout_height="wrap_content"
                android:layout_marginTop="8.0dip"
                android:fontFamily="@font/kufi"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@id/guidelineRight"
                app:layout_constraintTop_toBottomOf="@id/awayTeamLogoCard" />
            <LinearLayout
                android:gravity="center"
                android:orientation="vertical"
                android:id="@id/centerSection"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:layout_constraintBottom_toBottomOf="@id/homeTeamName"
                app:layout_constraintEnd_toStartOf="@id/awayTeamLogoCard"
                app:layout_constraintStart_toEndOf="@id/homeTeamLogoCard"
                app:layout_constraintTop_toTopOf="@id/homeTeamLogoCard">
                <LinearLayout
                    android:gravity="center"
                    android:orientation="horizontal"
                    android:id="@id/liveIndicator"
                    android:background="@drawable/live_indicator_bg"
                    android:paddingLeft="9.0dip"
                    android:paddingTop="2.0dip"
                    android:paddingRight="9.0dip"
                    android:paddingBottom="2.0dip"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:paddingHorizontal="9.0dip"
                    android:paddingVertical="2.0dip">
                    <View
                        android:id="@id/liveDot"
                        android:background="@drawable/live_dot"
                        android:layout_width="7.0dip"
                        android:layout_height="7.0dip" />
                    <TextView
                        android:textSize="10.0sp"
                        android:textStyle="bold"
                        android:textColor="#fff00000"
                        android:id="@id/liveText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="LIVE"
                        android:layout_marginStart="4.0dip" />
                    <TextView
                        android:textSize="10.0sp"
                        android:textStyle="bold"
                        android:textColor="#ff4caf50"
                        android:id="@id/matchMinute"
                        android:visibility="gone"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="4.0dip" />
                </LinearLayout>
                <TextView
                    android:textSize="28.0sp"
                    android:textStyle="bold"
                    android:textColor="?colorOnSurface"
                    android:id="@id/matchScore"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8.0dip" />
                <TextView
                    android:textSize="12.0sp"
                    android:textColor="?colorOnSurface"
                    android:id="@id/matchTime"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2.0dip"
                    android:alpha="0.5" />
                <TextView
                    android:textSize="10.0sp"
                    android:textColor="?colorOnSurface"
                    android:ellipsize="end"
                    android:id="@id/stadiumName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4.0dip"
                    android:maxWidth="120.0dip"
                    android:maxLines="1"
                    android:alpha="0.5"
                    android:fontFamily="@font/kufi" />
            </LinearLayout>
            <androidx.constraintlayout.widget.Guideline
                android:orientation="vertical"
                android:id="@id/guidelineLeft"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:layout_constraintGuide_percent="0.35" />
            <androidx.constraintlayout.widget.Guideline
                android:orientation="vertical"
                android:id="@id/guidelineRight"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:layout_constraintGuide_percent="0.65" />
        </androidx.constraintlayout.widget.ConstraintLayout>
        <View
            android:id="@id/divider"
            android:background="?colorOnSurface"
            android:layout_width="0.0dip"
            android:layout_height="1.0dip"
            android:layout_marginTop="16.0dip"
            android:alpha="0.1"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/teamsSection" />
        <LinearLayout
            android:gravity="center"
            android:orientation="horizontal"
            android:id="@id/infoSection"
            android:paddingTop="12.0dip"
            android:paddingBottom="12.0dip"
            android:layout_width="0.0dip"
            android:layout_height="wrap_content"
            android:paddingVertical="12.0dip"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/divider">
            <LinearLayout
                android:gravity="center"
                android:orientation="horizontal"
                android:layout_width="0.0dip"
                android:layout_height="wrap_content"
                android:layout_weight="1.0"
                android:paddingEnd="8.0dip">
                <ImageView
                    android:layout_width="18.0dip"
                    android:layout_height="18.0dip"
                    android:src="@drawable/ic_tv"
                    android:alpha="0.6"
                    app:tint="?colorOnSurface" />
                <TextView
                    android:textSize="11.0sp"
                    android:textStyle="bold"
                    android:textColor="?colorOnSurface"
                    android:id="@id/channelName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:alpha="0.8"
                    android:layout_marginStart="6.0dip" />
            </LinearLayout>
            <View
                android:background="?colorOnSurface"
                android:layout_width="1.0dip"
                android:layout_height="fill_parent"
                android:alpha="0.15" />
            <LinearLayout
                android:gravity="center"
                android:orientation="horizontal"
                android:layout_width="0.0dip"
                android:layout_height="wrap_content"
                android:layout_weight="1.0"
                android:paddingStart="8.0dip">
                <ImageView
                    android:layout_width="18.0dip"
                    android:layout_height="18.0dip"
                    android:src="@drawable/ic_mic"
                    android:alpha="0.6"
                    app:tint="?colorOnSurface" />
                <TextView
                    android:textSize="11.0sp"
                    android:textStyle="bold"
                    android:textColor="?colorOnSurface"
                    android:id="@id/commentatorName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:alpha="0.8"
                    android:fontFamily="@font/kufi"
                    android:layout_marginStart="6.0dip" />
            </LinearLayout>
        </LinearLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>
</com.google.android.material.card.MaterialCardView>