<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout
    android:background="@android:color/transparent"
    android:layout_width="fill_parent"
    android:layout_height="fill_parent"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <View
        android:id="@id/control_overlay"
        android:background="#80000000"
        android:visibility="gone"
        android:layout_width="fill_parent"
        android:layout_height="fill_parent" />
    <HorizontalScrollView
        android:id="@id/quality_scroll_view"
        android:paddingLeft="16.0dip"
        android:paddingRight="16.0dip"
        android:visibility="gone"
        android:scrollbars="none"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="50.0dip"
        android:layout_alignParentTop="true"
        android:paddingHorizontal="16.0dip">
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:id="@id/quality_container"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />
    </HorizontalScrollView>
    <RelativeLayout
        android:id="@id/top_bar"
        android:background="@drawable/gradient_top"
        android:padding="6.0dip"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true">
        <ImageButton
            android:id="@id/pip_button"
            android:background="?selectableItemBackgroundBorderless"
            android:padding="4.0dip"
            android:visibility="visible"
            android:layout_width="38.0dip"
            android:layout_height="38.0dip"
            android:src="@drawable/ic_pip"
            android:scaleType="centerInside"
            android:contentDescription="Picture-in-Picture"
            android:layout_alignParentEnd="true"
            app:tint="@android:color/white" />
    </RelativeLayout>
    <RelativeLayout
        android:layout_width="fill_parent"
        android:layout_height="fill_parent">
        <LinearLayout
            android:gravity="center"
            android:orientation="horizontal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true">
            <ImageButton
                android:id="@id/exo_rew"
                android:background="?selectableItemBackgroundBorderless"
                android:layout_width="32.0dip"
                android:layout_height="32.0dip"
                android:src="@drawable/ic_exo_rew"
                android:scaleType="centerInside"
                android:contentDescription="Rewind"
                android:layout_marginEnd="40.0dip"
                app:tint="@android:color/white" />
            <ImageButton
                android:id="@id/exo_play_pause"
                android:background="?selectableItemBackgroundBorderless"
                android:layout_width="48.0dip"
                android:layout_height="48.0dip"
                android:scaleType="centerInside"
                android:contentDescription="Play/Pause"
                android:layout_marginStart="12.0dip"
                android:layout_marginEnd="12.0dip"
                app:tint="@android:color/white" />
            <ImageButton
                android:id="@id/exo_ffwd"
                android:background="?selectableItemBackgroundBorderless"
                android:layout_width="32.0dip"
                android:layout_height="32.0dip"
                android:src="@drawable/ic_exo_ffwd"
                android:scaleType="centerInside"
                android:contentDescription="Fast Forward"
                android:layout_marginStart="40.0dip"
                app:tint="@android:color/white" />
        </LinearLayout>
    </RelativeLayout>
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:background="@drawable/gradient_bottom"
        android:paddingBottom="6.0dip"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:paddingStart="10.0dip"
        android:paddingEnd="10.0dip">
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:id="@id/live_indicator_layout"
            android:visibility="visible"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingEnd="6.0dip">
            <ImageView
                android:layout_width="6.0dip"
                android:layout_height="6.0dip"
                android:src="@drawable/live_dot" />
            <TextView
                android:textSize="10.0sp"
                android:textStyle="bold"
                android:textColor="@android:color/white"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="LIVE"
                android:layout_marginStart="3.0dip" />
        </LinearLayout>
        <TextView
            android:textSize="11.0sp"
            android:textColor="#ffffffff"
            android:id="@id/exo_position"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minWidth="35.0dip"
            android:includeFontPadding="false"
            android:paddingStart="2.0dip"
            android:paddingEnd="2.0dip" />
        <androidx.media3.ui.DefaultTimeBar
            android:id="@id/exo_progress"
            android:layout_width="0.0dip"
            android:layout_height="26.0dip"
            android:layout_weight="1.0"
            android:layout_marginStart="4.0dip"
            android:layout_marginEnd="4.0dip"
            app:bar_height="3.0dip"
            app:buffered_color="#80ffffff"
            app:played_color="@color/red_finished"
            app:scrubber_color="@color/red_finished"
            app:scrubber_disabled_size="0.0dip"
            app:scrubber_enabled_size="12.0dip"
            app:touch_target_height="26.0dip"
            app:unplayed_color="#4dffffff" />
        <TextView
            android:textSize="11.0sp"
            android:textColor="#ffffffff"
            android:id="@id/exo_duration"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minWidth="35.0dip"
            android:includeFontPadding="false"
            android:paddingStart="2.0dip"
            android:paddingEnd="2.0dip" />
        <ImageButton
            android:id="@id/btn_resize"
            android:background="?selectableItemBackgroundBorderless"
            android:padding="3.0dip"
            android:layout_width="30.0dip"
            android:layout_height="30.0dip"
            android:src="@drawable/ic_resize_mode"
            android:scaleType="centerInside"
            android:contentDescription="Resize Mode"
            android:layout_marginStart="4.0dip"
            app:tint="@android:color/white" />
        <ImageButton
            android:id="@id/exo_fullscreen"
            android:background="?selectableItemBackgroundBorderless"
            android:padding="3.0dip"
            android:visibility="visible"
            android:layout_width="30.0dip"
            android:layout_height="30.0dip"
            android:src="@drawable/ic_fullscreen_enter"
            android:scaleType="centerInside"
            android:contentDescription="Fullscreen"
            android:layout_marginStart="4.0dip"
            app:tint="@android:color/white" />
    </LinearLayout>
</RelativeLayout>